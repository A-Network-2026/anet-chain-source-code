DATABASE_URL=postgres://postgres:password@localhost:5432/a_network
PGSSLMODE=disable
PORT=8080
RUST_LOG=info
ANET_EPOCH_SECONDS=2
ANET_WEB2_SYNC_SECONDS=60
ANET_EXPLORER_DASHBOARD_CACHE_MS=5000
ANET_EXPLORER_DASHBOARD_SOFT_TIMEOUT_MS=1500
ANET_EXPLORER_DASHBOARD_BACKOFF_MS=10000
ANET_EXPLORER_ROOM_BOT_GUARD=true
ANET_EXPLORER_DETAIL_CACHE_MS=10000
ANET_DEX_ADMIN_KEY=replace-with-long-random-secret
ADMIN_ENDPOINTS_ENABLED=false
ANET_ALLOW_ADMIN_NATIVE_MINT=false
ANET_EXPLORER_AUTH_REQUIRED=false
ANET_ALLOW_INELIGIBLE_WALLET_TEST=false
ANET_TEST_FAUCET_ENABLED=false
ANET_GENESIS_PATH=config/genesis.json
ANET_CHAIN_PATH=data/chain.json